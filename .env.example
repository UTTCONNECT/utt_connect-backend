# Firebase (emulador)
FIREBASE_PROJECT_ID=demo-utt-connect
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Enlaces
FRONTEND_URL=http://localhost:4200
MAGIC_LINK_TTL_MINUTES=15