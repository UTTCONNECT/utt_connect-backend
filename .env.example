# .env.example
NODE_ENV=development
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esto
DB_NAME=utt_connect

# JWT propio de la API
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
